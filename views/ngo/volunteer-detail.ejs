<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: volunteer.name }) %>
<body>
  <%- include('../partials/navbar') %>
  <main class="container detail-page">
    <div class="detail-head">
      <div>
        <a href="/admin/volunteers" class="link-back mb-xs" style="display:inline-block; font-size: var(--fs-caption); font-weight:700;">← Back to All Volunteers</a>
        <h1 style="margin-bottom:0;"><%= volunteer.name %></h1>
        <p class="muted mb-0">✉️ <%= volunteer.email %> · 📞 <%= volunteer.phone %></p>
      </div>
      <div style="display:flex; align-items:center; gap:var(--space-sm); flex-wrap:wrap;">
        <span class="pill <%= volunteer.statusBadgeClass %>" style="font-size: var(--fs-body-sm); padding: 0.5em 1em;">
          <%= volunteer.liveStatusLabel %>
        </span>
        <% if (volunteer.avgRating > 0) { %>
          <span class="pill pill-delivered" style="font-size: var(--fs-body-sm); padding: 0.5em 1em;">⭐ <%= volunteer.avgRating.toFixed(1) %> (<%= volunteer.ratingCount %> ratings)</span>
        <% } %>
      </div>
    </div>

    <!-- Stat Grid -->
    <div class="stat-grid mt-lg" style="grid-template-columns: repeat(4, 1fr);">
      <div class="stat-card">
        <span class="stat-value"><%= volunteer.completedTasks %></span>
        <span class="stat-label">Completed Tasks</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= volunteer.isApproved ? 'Approved' : 'Pending' %></span>
        <span class="stat-label">Approval</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" style="font-size: 1.3rem;"><%= volunteer.liveStatusLabel %></span>
        <span class="stat-label">Live Status</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" style="font-size: 1.25rem;"><%= volunteer.timeWindowText %></span>
        <span class="stat-label">Working Hours</span>
      </div>
    </div>

    <!-- Live Availability Schedule & Active Task -->
    <div class="card mt-lg" style="background: var(--color-surface-alt); border-left: 4px solid var(--color-primary);">
      <h2>Live Availability & Shift Schedule</h2>
      <div class="schedule-grid">
        <div>
          <span class="muted" style="font-size: var(--fs-caption); font-weight: 700; text-transform: uppercase;">🗓️ Available Day / Date</span>
          <p class="mb-0" style="font-size: 1.05rem; font-weight: 700;"><%= volunteer.scheduleDateText %></p>
        </div>
        <div>
          <span class="muted" style="font-size: var(--fs-caption); font-weight: 700; text-transform: uppercase;">🕒 Daily Shift Window</span>
          <p class="mb-0" style="font-size: 1.05rem; font-weight: 700;"><%= volunteer.timeWindowText %></p>
        </div>
        <div>
          <span class="muted" style="font-size: var(--fs-caption); font-weight: 700; text-transform: uppercase;">ℹ️ Free-at Indicator</span>
          <p class="mb-0 <%= volunteer.liveStatus === 'busy' ? 'text-warning' : 'text-success' %>" style="font-size: 1rem; font-weight: 700;">
            <%= volunteer.whenFreeText %>
          </p>
        </div>
      </div>

      <% if (volunteer.activeTaskInfo) { %>
        <div class="active-task-detail-box mt-md">
          <div class="section-heading" style="margin-bottom: var(--space-xs);">
            <strong style="color: #9a3412;">🚀 Currently Active Delivery Task</strong>
            <span class="pill pill-<%= volunteer.activeTaskInfo.taskStatus %>"><%= volunteer.activeTaskInfo.taskStatusLabel %></span>
          </div>
          <p class="mb-0">
            <strong><%= volunteer.activeTaskInfo.taskCode %></strong> (<%= volunteer.activeTaskInfo.taskType %>)
          </p>
          <p class="mb-0 muted" style="font-size: var(--fs-body-sm);">
            📍 <strong>Pickup:</strong> <%= volunteer.activeTaskInfo.pickupAddress %>
          </p>
          <p class="mb-0 muted" style="font-size: var(--fs-body-sm);">
            📍 <strong>Drop-off:</strong> <%= volunteer.activeTaskInfo.deliveryAddress %>
          </p>
        </div>
      <% } %>
    </div>

    <!-- Tasks and Feedback -->
    <div class="detail-cols mt-lg">
      <section class="card">
        <h2>Task History</h2>
        <% if (tasks.length === 0) { %>
          <p class="mb-0 muted">No tasks assigned yet.</p>
        <% } else { %>
          <ul class="donation-rows">
            <% tasks.forEach(t => { %>
              <li class="donation-row">
                <div>
                  <strong><%= t.donationId ? t.donationId.donationCode : 'Elderly food request' %></strong>
                  <span class="muted"> · <%= t.donationId ? t.donationId.type : (t.foodRequestId ? t.foodRequestId.requirements : 'Food delivery') %></span>
                </div>
                <span class="pill pill-<%= t.status %>"><%= t.status.replace(/_/g, ' ') %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="card">
        <h2>Feedback Submitted</h2>
        <% if (feedback.length === 0) { %>
          <p class="mb-0 muted">No feedback logged yet.</p>
        <% } else { %>
          <% feedback.forEach(f => { %>
            <div class="mb-0" style="border-top: 1px solid var(--color-border); padding: var(--space-sm) 0;">
              <p class="mb-0"><%= '⭐'.repeat(f.rating) %> <span class="muted">(<%= f.category %>)</span></p>
              <% if (f.comment) { %><p class="mb-0 muted" style="font-size: var(--fs-body-sm);"><%= f.comment %></p><% } %>
            </div>
          <% }) %>
        <% } %>
      </section>
    </div>
  </main>
  <%- include('../partials/footer') %>

  <style>
    .detail-page { padding: var(--space-xl) 0; }
    .detail-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); flex-wrap: wrap; }
    .stat-grid { display: grid; gap: var(--space-md); }
    .stat-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-md); text-align: center; }
    .stat-value { display: block; font-family: var(--font-display); font-size: var(--fs-display-md); font-weight: 700; color: var(--color-primary); }
    .stat-label { font-size: var(--fs-body-sm); color: var(--color-muted); }
    .schedule-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin-top: var(--space-sm); }
    .active-task-detail-box { background: #fff7ed; border: 1px solid #fed7aa; border-radius: var(--radius-md); padding: var(--space-md); }
    .detail-cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); align-items: start; }
    .donation-rows li { border-top: 1px solid var(--color-border); }
    .donation-rows li:first-child { border-top: none; }
    .donation-row { display: flex; align-items: center; justify-content: space-between; padding: var(--space-sm) 0; }
    .text-warning { color: #c2410c !important; }
    .text-success { color: #15803d !important; }
    @media (max-width: 860px) {
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
      .schedule-grid { grid-template-columns: 1fr; }
      .detail-cols { grid-template-columns: 1fr; }
    }
  </style>
</body>
</html>
