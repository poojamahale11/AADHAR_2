<!DOCTYPE html>
<html lang="en">
  <!-- add button -->
<%- include('../partials/head', { title: 'Log In', extraCss: ['/css/auth.css'] }) %>
<body>
  <div class="auth-shell">
    <aside class="auth-brand">
      <div class="auth-brand-header">
        <img src="/images/logo.svg" alt="AADHAR logo" class="auth-brand-logo-image" />
        <div class="auth-brand-logo">AADHAR <span>— The Soul Serves</span></div>
      </div>
      <div class="auth-brand-copy">
        <h1>Welcome back to the trail of giving.</h1>
        <p>Sign in to pick up where you left off — whether that's tracking a donation, managing pickups, or delivering hope.</p>
        <div class="auth-journey">
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">D</span> Donation logged</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">V</span> Volunteer assigned</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">✓</span> Delivered with proof</div>
          </div>
        </div>
      </div>
      <div></div>
    </aside>

    <main class="auth-form-side">
      <div class="auth-form-wrap">
        <h2><%= adminOnly ? 'Lions Club Admin' : 'Log in' %></h2>
        <p class="subhead muted"><%= adminOnly ? 'Use the Lions Club administrator credentials to manage the platform.' : 'Enter your credentials to access your dashboard.' %></p>

        <% if (typeof passwordReset !== 'undefined' && passwordReset) { %>
          <div class="alert alert-success">
            <strong>✓ Password reset successful!</strong><br>
            You can now log in with your new password.
          </div>
        <% } %>

        <% if (errors && errors.length) { %>
          <div class="alert alert-error">
            <% errors.forEach(function(e) { %><div><%= e %></div><% }) %>
          </div>
        <% } %>

        <form action="<%= loginAction %>" method="POST" novalidate>
          <div class="field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required value="<%= formData && formData.email ? formData.email : '' %>" autocomplete="email" />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required autocomplete="current-password" />
            <% if (!adminOnly) { %>
              <div class="hint" style="text-align: right; margin-top: 0.25rem;">
                <a href="/forgot-password" style="font-size: var(--fs-body-sm); color: var(--color-primary); font-weight: 600;">Forgot password?</a>
              </div>
            <% } %>
          </div>

          <div class="recaptcha-note">
            reCAPTCHA is wired up server-side; the widget will appear here once <code>RECAPTCHA_SITE_KEY</code> is set in <code>.env</code>.
          </div>
          <% if (recaptchaSiteKey && recaptchaSiteKey !== 'your_recaptcha_site_key_here') { %>
            <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
          <% } %>

          <button type="submit" class="btn btn-primary btn-block">Log in</button>
        </form>

        <div class="auth-divider">
          <span>or</span>
        </div>

        <a href="/auth/google" class="btn btn-google btn-block">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 8px;">
            <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/>
            <path d="M9.003 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.96v2.332C2.44 15.983 5.485 18 9.003 18z" fill="#34A853"/>
            <path d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
            <path d="M9.003 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.464.891 11.426 0 9.003 0 5.485 0 2.44 2.017.96 4.958L3.967 7.29c.708-2.127 2.692-3.71 5.036-3.71z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </a>

        <% if (adminOnly) { %>
          <div class="auth-switch"><a href="/login">Donor or volunteer? Log in here.</a></div>
        <% } else { %>
          <div class="auth-switch">New to Lions Club? <a href="/signup">Create an account</a></div>
          <div class="auth-switch elderly-login-link">An elderly couple needing food? <a href="/signup">Create a household account</a></div>
        <% } %>
      </div>
    </main>
  </div>

  <% if (recaptchaSiteKey && recaptchaSiteKey !== 'your_recaptcha_site_key_here') { %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <% } %>
</body>
</html>
