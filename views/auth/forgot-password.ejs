<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Forgot Password', extraCss: ['/css/auth.css'] }) %>
<body>
  <div class="auth-shell">
    <aside class="auth-brand">
      <div class="auth-brand-header">
        <img src="/images/logo.svg" alt="AADHAR logo" class="auth-brand-logo-image" />
        <div class="auth-brand-logo">AADHAR <span>— The Soul Serves</span></div>
      </div>
      <div class="auth-brand-copy">
        <h1>Forgot your password?</h1>
        <p>No worries — it happens to everyone. Enter your email address below and we'll send you a secure link to reset your password.</p>
        <div class="auth-journey">
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">📧</span> Enter your email</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">🔗</span> Receive reset link</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">🔐</span> Set new password</div>
          </div>
        </div>
      </div>
      <div></div>
    </aside>

    <main class="auth-form-side">
      <div class="auth-form-wrap">
        <a href="/login" class="link-back mb-sm">← Back to login</a>
        <h2>Reset your password</h2>
        <p class="subhead muted">Enter the email address associated with your AADHAR account and we'll send you instructions to reset your password.</p>

        <% if (success) { %>
          <div class="alert alert-success">
            <strong>✓ Email sent!</strong><br>
            <%= successMessage || 'If an account exists with that email address, you will receive password reset instructions shortly.' %>
          </div>
          <p class="muted" style="font-size: var(--fs-body-sm); margin-top: var(--space-md);">
            <strong>Didn't receive the email?</strong> Check your spam folder or try again in a few minutes.
          </p>
        <% } %>

        <% if (errors && errors.length && !success) { %>
          <div class="alert alert-error">
            <% errors.forEach(function(e) { %><div><%= e %></div><% }) %>
          </div>
        <% } %>

        <% if (!success) { %>
          <form action="/forgot-password" method="POST" novalidate>
            <div class="field">
              <label for="email">Email address</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                value="<%= formData && formData.email ? formData.email : '' %>" 
                autocomplete="email"
                placeholder="your.email@example.com"
              />
              <div class="hint">We'll send a password reset link to this email address.</div>
            </div>

            <div class="recaptcha-note">
              reCAPTCHA is wired up server-side; the widget will appear here once <code>RECAPTCHA_SITE_KEY</code> is set in <code>.env</code>.
            </div>
            <% if (recaptchaSiteKey && recaptchaSiteKey !== 'your_recaptcha_site_key_here') { %>
              <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
            <% } %>

            <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
          </form>
        <% } else { %>
          <div class="auth-switch" style="margin-top: var(--space-lg);">
            <a href="/login" class="btn btn-outline btn-block">Return to login</a>
          </div>
        <% } %>

        <div class="auth-divider">
          <span>or</span>
        </div>

        <div class="auth-switch">
          Remember your password? <a href="/login">Log in</a>
        </div>
        <div class="auth-switch">
          Don't have an account? <a href="/signup">Sign up</a>
        </div>
      </div>
    </main>
  </div>

  <% if (recaptchaSiteKey && recaptchaSiteKey !== 'your_recaptcha_site_key_here') { %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <% } %>
</body>
</html>
