<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Reset Password', extraCss: ['/css/auth.css'] }) %>
<body>
  <div class="auth-shell">
    <aside class="auth-brand">
      <div class="auth-brand-header">
        <img src="/images/logo.svg" alt="AADHAR logo" class="auth-brand-logo-image" />
        <div class="auth-brand-logo">AADHAR <span>— The Soul Serves</span></div>
      </div>
      <div class="auth-brand-copy">
        <h1>Create a new password</h1>
        <p>Choose a strong, unique password that you don't use for other accounts. Your password should be at least 8 characters long.</p>
        <div class="auth-journey">
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">🔐</span> Secure password</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">✓</span> Confirm match</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">✓</span> Log in securely</div>
          </div>
        </div>
      </div>
      <div></div>
    </aside>

    <main class="auth-form-side">
      <div class="auth-form-wrap">
        <a href="/login" class="link-back mb-sm">← Back to login</a>
        <h2>Set new password</h2>
        <% if (validToken && userName) { %>
          <p class="subhead muted">Hi <strong><%= userName %></strong>, enter your new password below to secure your AADHAR account.</p>
        <% } else { %>
          <p class="subhead muted">Enter your new password to secure your AADHAR account.</p>
        <% } %>

        <% if (errors && errors.length) { %>
          <div class="alert alert-error">
            <% errors.forEach(function(e) { %><div><%= e %></div><% }) %>
          </div>
          <% if (!validToken) { %>
            <div class="auth-switch" style="margin-top: var(--space-md);">
              <a href="/forgot-password" class="btn btn-outline btn-block">Request a new reset link</a>
            </div>
            <div class="auth-divider"><span>or</span></div>
            <div class="auth-switch">
              <a href="/login">Return to login</a>
            </div>
          <% } %>
        <% } %>

        <% if (validToken) { %>
          <form action="/reset-password" method="POST" novalidate>
            <input type="hidden" name="token" value="<%= token %>" />

            <div class="field">
              <label for="newPassword">New password</label>
              <input 
                type="password" 
                id="newPassword" 
                name="newPassword" 
                required 
                minlength="8"
                autocomplete="new-password"
                placeholder="At least 8 characters"
              />
              <div class="hint">Choose a strong password with letters, numbers, and special characters.</div>
            </div>

            <div class="field">
              <label for="confirmPassword">Confirm new password</label>
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                required 
                minlength="8"
                autocomplete="new-password"
                placeholder="Re-enter your password"
              />
              <div class="hint">Make sure both passwords match.</div>
            </div>

            <div class="password-requirements">
              <p style="font-weight: 600; font-size: var(--fs-body-sm); margin-bottom: var(--space-xs); color: var(--color-ink);">Password requirements:</p>
              <ul style="font-size: var(--fs-body-sm); color: var(--color-muted); line-height: 1.6; padding-left: 1.2rem; margin: 0;">
                <li>At least 8 characters long</li>
                <li>Should contain a mix of letters and numbers</li>
                <li>Special characters recommended for added security</li>
              </ul>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Reset password</button>
          </form>

          <div class="auth-divider">
            <span>or</span>
          </div>

          <div class="auth-switch">
            Remember your password? <a href="/login">Log in</a>
          </div>
        <% } %>
      </div>
    </main>
  </div>

  <% if (validToken) { %>
    <script>
      // Client-side password validation
      (function() {
        var form = document.querySelector('form');
        var newPass = document.getElementById('newPassword');
        var confirmPass = document.getElementById('confirmPassword');

        // Password strength indicator
        function checkPasswordStrength(password) {
          var strength = 0;
          if (password.length >= 8) strength++;
          if (password.length >= 12) strength++;
          if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
          if (/\d/.test(password)) strength++;
          if (/[^a-zA-Z0-9]/.test(password)) strength++;
          return strength;
        }

        function updatePasswordStrength() {
          var password = newPass.value;
          var strength = checkPasswordStrength(password);
          var indicator = document.getElementById('password-strength');
          
          if (!indicator && password.length > 0) {
            indicator = document.createElement('div');
            indicator.id = 'password-strength';
            indicator.style.marginTop = '0.5rem';
            indicator.style.fontSize = '0.85rem';
            indicator.style.fontWeight = '600';
            newPass.parentNode.appendChild(indicator);
          }

          if (indicator) {
            if (password.length === 0) {
              indicator.style.display = 'none';
            } else {
              indicator.style.display = 'block';
              if (strength < 2) {
                indicator.textContent = '🔴 Weak password';
                indicator.style.color = '#dc2626';
              } else if (strength < 4) {
                indicator.textContent = '🟡 Moderate password';
                indicator.style.color = '#f59e0b';
              } else {
                indicator.textContent = '🟢 Strong password';
                indicator.style.color = '#16a34a';
              }
            }
          }
        }

        function validatePasswords() {
          if (confirmPass.value && newPass.value !== confirmPass.value) {
            confirmPass.setCustomValidity('Passwords do not match');
          } else {
            confirmPass.setCustomValidity('');
          }
        }

        if (newPass && confirmPass) {
          newPass.addEventListener('input', function() {
            updatePasswordStrength();
            validatePasswords();
          });
          confirmPass.addEventListener('input', validatePasswords);
        }

        // Form submission validation
        if (form) {
          form.addEventListener('submit', function(e) {
            if (newPass.value.length < 8) {
              e.preventDefault();
              alert('Password must be at least 8 characters long.');
              newPass.focus();
              return false;
            }
            if (newPass.value !== confirmPass.value) {
              e.preventDefault();
              alert('Passwords do not match. Please make sure both passwords are identical.');
              confirmPass.focus();
              return false;
            }
          });
        }
      })();
    </script>
  <% } %>
</body>
</html>
