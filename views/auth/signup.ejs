<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Sign Up', extraCss: ['/css/auth.css'] }) %>
<body>
  <div class="auth-shell">
    <aside class="auth-brand">
      <div class="auth-brand-header">
        <img src="/images/logo.svg" alt="AADHAR logo" class="auth-brand-logo-image" />
        <div class="auth-brand-logo">AADHAR <span>— The Soul Serves</span></div>
      </div>
      <div class="auth-brand-copy">
        <h1>Every account starts a new trail.</h1>
        <p>Whether you're giving, delivering, or coordinating — your first donation's journey begins the moment you sign up.</p>
        <div class="auth-journey">
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">1</span> Choose your role</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">2</span> Tell us who you are</div>
            <div class="trail-line"></div>
          </div>
          <div class="auth-journey-row">
            <div class="auth-journey-step"><span class="trail-node">3</span> Start making impact</div>
          </div>
        </div>
      </div>
      <div></div>
    </aside>

    <main class="auth-form-side">
      <div class="auth-form-wrap">
        <h2>Create your account</h2>
        <p class="subhead muted">Join as a donor, volunteer, or household requesting food support.</p>

        <% if (errors && errors.length) { %>
          <div class="alert alert-error">
            <% errors.forEach(function(e) { %><div><%= e %></div><% }) %>
          </div>
        <% } %>

        <form action="/signup" method="POST" novalidate id="signup-form">
          <div class="field">
            <label>I am signing up as a...</label>
            <div class="role-picker">
              <label class="role-option">
                <input type="radio" name="role" value="donor" <%= (!formData || !formData.role || formData.role === 'donor') ? 'checked' : '' %> />
                <span class="role-option-icon">🎁</span>
                <span>Donor</span>
              </label>
              <label class="role-option">
                <input type="radio" name="role" value="volunteer" <%= formData && formData.role === 'volunteer' ? 'checked' : '' %> />
                <span class="role-option-icon">🚲</span>
                <span>Volunteer</span>
              </label>
              <label class="role-option">
                <input type="radio" name="role" value="elderly" <%= formData && formData.role === 'elderly' ? 'checked' : '' %> />
                Elderly couple
              </label>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="name">Full name</label>
              <input type="text" id="name" name="name" required value="<%= formData && formData.name ? formData.name : '' %>" />
            </div>
            <div class="field">
              <label for="phone">Phone number</label>
              <input type="tel" id="phone" name="phone" required pattern="[0-9]{10}" placeholder="10-digit number" value="<%= formData && formData.phone ? formData.phone : '' %>" />
            </div>
          </div>

          <div class="field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required value="<%= formData && formData.email ? formData.email : '' %>" autocomplete="email" />
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" />
            <div class="hint">At least 8 characters, including one number.</div>
          </div>

          <!-- Donor-specific fields -->
          <div class="field role-specific" data-role="donor">
            <label for="donorType">Donor type</label>
            <select id="donorType" name="donorType">
              <option value="individual">Individual</option>
              <option value="hotel">Hotel</option>
              <option value="business">Business</option>
            </select>
          </div>
          <div class="field role-specific" data-role="donor" data-donor-type="hotel,business">
            <label for="organizationNameDonor">Organization name</label>
            <input type="text" id="organizationNameDonor" name="organizationName" value="<%= formData && formData.organizationName ? formData.organizationName : '' %>" />
          </div>

          <!-- Volunteers are automatically connected to the Lions Club. -->
          <div class="field role-specific" data-role="volunteer">
            <label>Lions Club</label>
            <div class="hint">Your volunteer account will be connected to Lions Club for approval and task assignment.</div>
          </div>
          <div class="field role-specific" data-role="volunteer">
            <label for="skills">Skills you can offer (optional)</label>
            <input type="text" id="skills" name="skills" placeholder="e.g. tutoring, cooking, driving" value="<%= formData && formData.skills ? formData.skills : '' %>" />
            <div class="hint">Comma-separated. Used for the skill-volunteering module.</div>
          </div>

          <div class="field role-specific" data-role="elderly">
            <label for="partnerName">Partner's full name</label>
            <input type="text" id="partnerName" name="partnerName" value="<%= formData && formData.partnerName ? formData.partnerName : '' %>" />
          </div>
          <div class="field role-specific" data-role="elderly">
            <label for="homeAddress">Home address for delivery</label>
            <textarea id="homeAddress" name="homeAddress" rows="3" placeholder="House number, street, area, city"><%= formData && formData.homeAddress ? formData.homeAddress : '' %></textarea>
          </div>

          <div class="recaptcha-note">
            reCAPTCHA is wired up server-side; the widget will appear here once <code>RECAPTCHA_SITE_KEY</code> is set in <code>.env</code>.
          </div>
          <% if (recaptchaSiteKey && recaptchaSiteKey !== 'your_recaptcha_site_key_here') { %>
            <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
          <% } %>

          <button type="submit" class="btn btn-primary btn-block">Create account</button>
        </form>

        <div class="auth-divider">
          <span>or</span>
        </div>

        <a href="/auth/google" class="btn btn-google btn-block">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 8px;">
            <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/>
            <path d="M9.003 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.96v2.332C2.44 15.983 5.485 18 9.003 18z" fill="#34A853"/>
            <path d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
            <path d="M9.003 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.464.891 11.426 0 9.003 0 5.485 0 2.44 2.017.96 4.958L3.967 7.29c.708-2.127 2.692-3.71 5.036-3.71z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </a>

        <div class="auth-switch">
          Already have an account? <a href="/login">Log in</a>
        </div>
      </div>
    </main>
  </div>

  <% if (recaptchaSiteKey && recaptchaSiteKey !== 'your_recaptcha_site_key_here') { %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <% } %>
  <script src="/js/signup.js"></script>
</body>
</html>
